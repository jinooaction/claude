# Python
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual env
.venv/
venv/

# uv
# (uv.lock is committed)

# Env / secrets
.env
.env.*
!.env.example
*.key
credentials.json

# IDE / OS
.vscode/
.idea/
.DS_Store
*.tmp

# Claude Code agent folder may contain auth tokens; per spec-kit guidance.
# Keep skills/commands committed but ignore anything sensitive.
.claude/settings.local.json
.claude/.credentials*
.codex/config.toml
.codex/state/

# Generated Codex/plugin bundle fragments sometimes land at repo root during
# local UI/plugin work; they are not deploy inputs.
/app-scope-*.js
/main-*.js
/src-*.js
/use-host-config-*.js
/vscode-api-*.js

# Build / dist
build/
dist/

# auto-invest runtime artifacts
data/
*.db
*.db-wal
*.db-shm
*.pid

# operator-specific TOML rules (the example fixture under tests/fixtures/rules/ is committed).
config/rules.toml
# Tuner-generated rule snapshots + generated reports. Produced on the server at
# runtime; NOT deploy inputs. Ignoring them keeps `git status` from marking the
# working tree "dirty" and freezing the deploy state machine.
config/rules_auto_*.toml
reports/

# Automation result/trigger files written by .github/workflows/ (verify-operator-setup.yml,
# trigger-design.yml). 결과 파일이라 main 누적 X. workflow가 실행된 branch 에만 남음.
.verify/
.trigger/
