[Unit]
Description=auto-invest deploy automation (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=auto-invest
Group=auto-invest
WorkingDirectory=/opt/auto-invest
EnvironmentFile=/opt/auto-invest/.env
# Share uv cache with auto-invest.service so both reuse the same lockfile/wheel store.
Environment=UV_CACHE_DIR=/opt/auto-invest/.cache/uv
# Keep the root-owned forced-command gateway/helpers in sync with origin/main
# before the unprivileged deploy state machine runs. The gateway still accepts
# only fixed commands; this pre-step installs those fixed-command files from
# main and does not touch worker state or live-money settings.
ExecStartPre=+/bin/bash -lc 'set -euo pipefail; install -d -m 0700 -o root -g root /run/auto-invest-deploy; sudo -u auto-invest git -C /opt/auto-invest fetch origin main --quiet || true; sudo -u auto-invest git -C /opt/auto-invest show origin/main:deploy/refresh-ssh-boundary-helpers.sh > /run/auto-invest-deploy/refresh-ssh-boundary-helpers.sh; chmod 0700 /run/auto-invest-deploy/refresh-ssh-boundary-helpers.sh; /bin/bash /run/auto-invest-deploy/refresh-ssh-boundary-helpers.sh'
ExecStart=/usr/local/bin/uv run auto-invest deploy --branch main
StandardOutput=journal
StandardError=journal
# NoNewPrivileges 는 두지 않는다(중요): 배포 상태기계가 워커 유닛을 제어하려면
# `sudo -n systemctl …`(setuid)이 필요한데, NoNewPrivileges=true 는 sudo 를 막는다.
# 권한 확대는 sudoers 드롭인(deploy/auto-invest-deploy.sudoers)으로 *워커 유닛의
# stop/start/restart/is-active 만* 으로 좁게 제한된다(polkit 보다 결정론적).
PrivateTmp=true
