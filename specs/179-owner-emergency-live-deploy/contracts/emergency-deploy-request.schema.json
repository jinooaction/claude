{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-invest.local/contracts/emergency-deploy-request.schema.json",
  "title": "Owner Emergency Deploy Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "target_sha",
    "actor",
    "workflow_run_id",
    "source",
    "reason_sha256",
    "issued_at_epoch",
    "expires_at_epoch"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^github-run-[1-9][0-9]*$"},
    "target_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "source": {"const": "github-actions-workflow-dispatch"},
    "reason_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at_epoch": {"type": "integer", "minimum": 1},
    "expires_at_epoch": {"type": "integer", "minimum": 1}
  }
}
